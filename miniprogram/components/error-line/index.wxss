.error-line {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-2);
  padding: var(--space-2) var(--space-3);
  border: 1rpx solid var(--color-destructive);
  border-radius: var(--radius-sm);
  background-color: rgba(239, 68, 68, 0.08);
}
.error-line__text { font-size: var(--font-sm); color: var(--color-destructive); flex: 1; }
.error-line__retry { font-size: var(--font-sm); color: var(--color-accent); }
