.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-6);
  gap: var(--space-2);
}
.loading__spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-accent);
  border-radius: 50%;
  animation: biuz-spin 0.8s linear infinite;
}
.loading__text { font-size: var(--font-sm); color: var(--color-muted); }
@keyframes biuz-spin { to { transform: rotate(360deg); } }
