.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-6);
  gap: var(--space-2);
}
.empty__title { font-size: var(--font-base); color: var(--color-foreground); }
.empty__hint { font-size: var(--font-sm); color: var(--color-muted); text-align: center; }
