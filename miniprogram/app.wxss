/* 朱批设计 token —— 印系纸/墨/朱磦（2026-11-21 朱批品牌升级，原「ZCode web 对齐板」作废；
 * 出处 brand/seal/README.md，与 iOS Theme.swift / Android Color.kt 同构映射）。
 *
 *   light: 纸底 #f7f3ec · 卡=纸 · 输入 #EFE9DF · 正文墨 #17181A（次级 62% / 最弱 40%）
 *   dark : 墨底 #17181A · 卡 #1C1D20 · 面 #232428 · 正文纸 #f7f3ec（次级 62% / 最弱 30%）
 *   印色 : 朱磦 #D2402E（加深 #B03020）——盖章/审批/品牌位专用，destructive 分工不变
 *   状态色族沿用 web 口径。
 *
 * 换算口径：web 手机壳固定 390pt 视口；小程序 750rpx = 屏宽 → 1px ≈ 1.923rpx。
 */
page {
  /* 浅色档（默认，跟随系统）—— 对齐 web :root */
  --color-background: #f7f3ec;
  --color-card: #f7f3ec;
  --color-elevated: #ffffff;
  --color-input: #efe9df;
  --color-code: #f1ece3;
  --color-border: rgba(23, 24, 26, 0.12);
  --color-border-strong: rgba(23, 24, 26, 0.18);
  --color-foreground: #17181a;
  --color-muted: rgba(23, 24, 26, 0.62);
  --color-muted-2: rgba(23, 24, 26, 0.4);
  --color-accent: #17181a;
  --color-on-accent: #f7f3ec;
  --color-accent-press: #000000;
  --color-accent-pill-border: rgba(23, 24, 26, 0.3);
  --color-accent-pill-text: rgba(23, 24, 26, 0.65);
  --color-info: #0ea5e9;
  --color-warning: #ca8a04;
  --color-destructive: #dc2626;
  --color-success: #16a34a;
  --color-violet: #7c3aed;
  --color-seal: #d2402e;
  --color-on-seal: #f7f3ec;
  --color-seal-dim: rgba(210, 64, 46, 0.1);

  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-6: 48rpx;

  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;

  --font-xs: 22rpx;
  --font-sm: 24rpx;
  --font-base: 28rpx;
  --font-lg: 32rpx;
  --font-title: 36rpx;

  background-color: var(--color-background);
  color: var(--color-foreground);
  font-size: var(--font-base);
  line-height: 1.5;
}

/* 深色档：与 iOS Theme.swift / Android Color.kt 的 dark 值逐字一致 */
@media (prefers-color-scheme: dark) {
  page {
    --color-background: #17181a;
    --color-card: #1c1d20;
    --color-elevated: #232428;
    --color-input: #222326;
    --color-code: #1b1c1f;
    --color-border: rgba(247, 243, 236, 0.12);
    --color-border-strong: rgba(247, 243, 236, 0.18);
    --color-foreground: #f7f3ec;
    --color-muted: rgba(247, 243, 236, 0.62);
    --color-muted-2: rgba(247, 243, 236, 0.3);
    --color-accent: #f0ede6;
    --color-on-accent: #17181a;
    --color-accent-press: #d8d5ce;
    --color-accent-pill-border: rgba(247, 243, 236, 0.3);
    --color-accent-pill-text: rgba(247, 243, 236, 0.65);
    --color-info: #38bdf8;
    --color-warning: #eab308;
    --color-destructive: #ff6467;
    --color-success: #22c55e;
    --color-violet: #c792ff;
    --color-seal: #d2402e;
    --color-on-seal: #f7f3ec;
    --color-seal-dim: rgba(210, 64, 46, 0.16);
  }
}

/* 安全区：web 用 dvh；小程序用环境变量，见 references/platform-differences.md §5 */
.safe-top {
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
}
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
}

.page-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: var(--space-6);
  gap: var(--space-2);
}
.page-placeholder__title {
  font-size: var(--font-title);
  color: var(--color-foreground);
}
.page-placeholder__hint {
  font-size: var(--font-sm);
  color: var(--color-muted-2);
  text-align: center;
}
