/* BiuZ 设计 token —— **完全对齐 ZCode web**（用户裁决 2026-11-09「整个 app 与 ZCode web 设计样式保持一致，
 * 先不用之前设计的 UI，完全复刻」；作废原 qoder 色板）。
 *
 * 取值来源：线上手机壳实测（`zcode.z.ai/remote/v4`，390×844，测量 body/侧栏/行/分区标题的计算样式）
 * + `packages/ui/src/styles.css` 的 :root / .dark 块：
 *   dark : bg #161616 · card/popover #171717 · surface #262626 · 正文 #d4d4d4(oklch .87)
 *          次级 = 正文 60% alpha · 最弱 = 正文 30% alpha · brand #e5e5e5(oklch .922) · destructive #ff6467
 *   分隔线 = 白 10% alpha · 输入/强边 = 白 15% alpha
 *   light: bg neutral-50 #fafafa · card #ffffff · 正文 neutral-700 #404040 · 次级 60% · 最弱 40%
 *          destructive red-600 #dc2626 · success green-600 #16a34a · warning yellow-600 #ca8a04
 *
 * 换算口径：web 手机壳固定 390pt 视口；小程序 750rpx = 屏宽 → 1px ≈ 1.923rpx。
 */
page {
  /* 浅色档（默认，跟随系统）—— 对齐 web :root */
  --color-background: #fafafa;
  --color-card: #ffffff;
  --color-elevated: #ffffff;
  --color-input: rgba(0, 0, 0, 0.06);
  --color-code: #f5f5f5;
  --color-border: rgba(0, 0, 0, 0.1);
  --color-border-strong: rgba(0, 0, 0, 0.15);
  --color-foreground: #404040;
  --color-muted: rgba(64, 64, 64, 0.6);
  --color-muted-2: rgba(64, 64, 64, 0.4);
  --color-accent: #e5e5e5;
  --color-on-accent: #171717;
  --color-accent-press: #d4d4d4;
  --color-accent-pill-border: rgba(23, 23, 23, 0.3);
  --color-accent-pill-text: rgba(23, 23, 23, 0.65);
  --color-info: #0ea5e9;
  --color-warning: #ca8a04;
  --color-destructive: #dc2626;
  --color-success: #16a34a;
  --color-violet: #7c3aed;

  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-6: 48rpx;

  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;

  --font-xs: 22rpx;
  --font-sm: 24rpx;
  --font-base: 28rpx;
  --font-lg: 32rpx;
  --font-title: 36rpx;

  background-color: var(--color-background);
  color: var(--color-foreground);
  font-size: var(--font-base);
  line-height: 1.5;
}

/* 深色档：与 iOS Theme.swift / Android Color.kt 的 dark 值逐字一致 */
@media (prefers-color-scheme: dark) {
  page {
    --color-background: #161616;
    --color-card: #171717;
    --color-elevated: #262626;
    --color-input: rgba(255, 255, 255, 0.15);
    --color-code: #171717;
    --color-border: rgba(255, 255, 255, 0.1);
    --color-border-strong: rgba(255, 255, 255, 0.15);
    --color-foreground: #d4d4d4;
    --color-muted: rgba(212, 212, 212, 0.6);
    --color-muted-2: rgba(212, 212, 212, 0.3);
    --color-accent: #e5e5e5;
    --color-on-accent: #171717;
    --color-accent-press: #d4d4d4;
    --color-accent-pill-border: rgba(23, 23, 23, 0.3);
    --color-accent-pill-text: rgba(23, 23, 23, 0.65);
    --color-info: #38bdf8;
    --color-warning: #eab308;
    --color-destructive: #ff6467;
    --color-success: #22c55e;
    --color-violet: #c792ff;
  }
}

/* 安全区：web 用 dvh；小程序用环境变量，见 references/platform-differences.md §5 */
.safe-top {
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
}
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
}

.page-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: var(--space-6);
  gap: var(--space-2);
}
.page-placeholder__title {
  font-size: var(--font-title);
  color: var(--color-foreground);
}
.page-placeholder__hint {
  font-size: var(--font-sm);
  color: var(--color-muted-2);
  text-align: center;
}
