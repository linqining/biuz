.page { min-height: 100vh; background: #f7f7f7; }
.header { display: flex; align-items: center; height: 96rpx; padding: 0 16rpx; }
.back { font-size: 52rpx; color: #111827; padding: 0 20rpx; }
.title { font-size: 34rpx; font-weight: 600; color: #111827; }
.divider { height: 1rpx; background: #e5e7eb; }
.state { padding: 80rpx 40rpx; display: flex; flex-direction: column; align-items: center; }
.state-title { font-size: 30rpx; color: #111827; margin-bottom: 12rpx; }
.state-hint { font-size: 26rpx; color: #9ca3af; text-align: center; }
.state-error { font-size: 26rpx; color: #dc2626; margin-bottom: 16rpx; text-align: center; }
.retry { font-size: 28rpx; color: #2563eb; padding: 8rpx 24rpx; }
.list { padding: 16rpx 24rpx 60rpx; }
.row { background: #ffffff; border: 1rpx solid #e5e7eb; border-radius: 16rpx;
  padding: 20rpx 24rpx; margin-bottom: 16rpx; display: flex; align-items: center; }
.row-main { flex: 1; display: flex; flex-direction: column; }
.row-title { font-size: 28rpx; color: #111827; }
.row-sub { font-size: 24rpx; color: #6b7280; margin-top: 4rpx; }
.badge { font-size: 22rpx; color: #6b7280; }
