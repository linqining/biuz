/* 001-登录 —— 对齐线上基线 .capture/runs/20261108-073043-001（390pt 卡片居中）。
   换算 1px ≈ 1.923rpx。 */

.login-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-left: 32rpx;
  padding-right: 32rpx;
  box-sizing: border-box;
  background-color: var(--color-background);
}

.login-card {
  width: 100%;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background-color: var(--color-card);
  padding: 38rpx;
  box-sizing: border-box;
}

.login-head {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: 38rpx;
}
.login-logo {
  width: 77rpx;
  height: 77rpx;
  border-radius: var(--radius-md);
  background-color: var(--color-accent);
  color: var(--color-on-accent);
  font-size: 38rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}
.login-head__text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.login-brand {
  font-size: var(--font-xs);
  font-weight: 500;
  color: var(--color-foreground);
}
.login-title {
  font-size: var(--font-lg);
  font-weight: 500;
  color: var(--color-foreground);
}

.login-desc {
  display: block;
  margin-bottom: 38rpx;
  font-size: var(--font-xs);
  line-height: 46rpx;
  color: var(--color-muted);
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  height: 88rpx;
  border-radius: var(--radius-md);
  background-color: var(--color-accent);
  color: var(--color-on-accent);
  margin-bottom: 16rpx;
}
.login-btn:last-child {
  margin-bottom: 0;
}
.login-btn:active {
  background-color: var(--color-accent-press);
}
.login-btn--disabled {
  opacity: 0.6;
}
.login-btn__icon {
  font-size: var(--font-base);
  font-weight: 700;
}
.login-btn__action {
  font-size: var(--font-base);
  font-weight: 500;
}
.login-btn__region {
  font-size: var(--font-xs);
  font-weight: 500;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  /* 药丸色跟随主题（app.wxss 里成对定义浅/深两档），不依赖 inherit/currentColor */
  border: 2rpx solid var(--color-accent-pill-border);
  color: var(--color-accent-pill-text);
}

.jwt-section { margin: 24rpx 32rpx 0; padding: 20rpx 24rpx; background: #ffffff; border: 1rpx solid #e5e7eb; border-radius: 16rpx; }
.jwt-issue { padding: 8rpx 0 12rpx; border-bottom: 1rpx solid #f3f4f6; }
.jwt-issue__text { font-size: 24rpx; color: #b45309; line-height: 1.5; }
.jwt-row { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0; }
.jwt-row + .jwt-row { border-top: 1rpx solid #f3f4f6; }
.jwt-label { font-size: 26rpx; color: #374151; }
.jwt-action { font-size: 24rpx; color: #2563eb; }

.relay-btn {
  margin: 24rpx 32rpx 0;
  background: #111827;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
  padding: 20rpx 0;
}
.relay-btn--disabled { opacity: 0.5; }
