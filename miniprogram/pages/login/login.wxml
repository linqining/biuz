<!-- 001-登录：居中卡片（品牌 + 标题 + 说明 + 双 provider 按钮） -->
<view class="page login-page" style="padding-top: {{statusBarHeight}}px">
  <view class="login-card">
    <view class="login-head">
      <view class="login-logo">Z</view>
      <view class="login-head__text">
        <text class="login-brand">{{copy.brand}}</text>
        <text class="login-title">{{copy.loginTitle}}</text>
      </view>
    </view>
    <text class="login-desc">{{copy.loginDescription}}</text>

    <view
      class="login-btn {{submitting ? 'login-btn--disabled' : ''}}"
      wx:for="{{copy.providers}}"
      wx:key="id"
      data-provider="{{item.id}}"
      bind:tap="onLogin">
      <text class="login-btn__icon">{{item.icon}}</text>
      <text class="login-btn__action">{{item.action}}</text>
      <text class="login-btn__region">{{item.region}}</text>
    </view>

    <!-- P-018：JWT 粘贴持久化（完整 OAuth 待 web-view + 白名单波次） -->
    <view class="jwt-section">
      <!-- 凭据读取失败原因（web 三分口径：密钥不可用 / 数据损坏 必须区别上屏，
           不再统一落到「未登录」——systemCredentialCipher.ts:67-75） -->
      <view wx:if="{{credentialIssue}}" class="jwt-issue" data-test="01-note-credential-issue">
        <text class="jwt-issue__text">{{credentialIssue}}</text>
      </view>
      <view class="jwt-row" bind:tap="onPasteJwt" data-test="01-act-paste-jwt">
        <text class="jwt-label">{{jwtStored ? 'JWT 已保存' : '粘贴 Z.ai JWT（中继连接用）'}}</text>
        <text class="jwt-action">{{jwtStored ? '更新' : '粘贴'}}</text>
      </view>
      <view wx:if="{{jwtStored}}" class="jwt-row" bind:tap="onClearJwt" data-test="01-act-clear-jwt">
        <text class="jwt-label" style="color: #dc2626">清除 JWT</text>
        <text class="jwt-action">×</text>
      </view>
    </view>
    <view class="relay-btn {{connecting ? 'relay-btn--disabled' : ''}}" bind:tap="onConnectRelay" data-test="01-act-relay">
      <text>{{connecting ? '正在连接中继…' : '连接中继'}}</text>
    </view>
  </view>
</view>
