.cc { display: flex; flex-direction: column; height: 100vh; background: #f7f3ec; }
.cc__head { display: flex; align-items: center; height: 96rpx; padding: 0 16rpx; }
.cc__back { font-size: 52rpx; color: #17181a; padding: 0 24rpx; }
.cc__title { font-size: 34rpx; font-weight: 600; color: #17181a; }
.cc__input {
  margin: 0 24rpx; padding: 12rpx 24rpx; font-size: 26rpx;
  background: #efe9df; border-radius: 16rpx;
}
.cc__scopes { display: flex; gap: 16rpx; padding: 16rpx 24rpx 0; }
.cc__scope {
  font-size: 24rpx; font-weight: 600; color: #5b5e63;
  padding: 8rpx 24rpx; border-radius: 999rpx; background: #efe9df;
}
.cc__scope--on { color: #d2402e; background: rgba(210, 64, 46, 0.14); }
.cc__history { margin-top: 16rpx; white-space: nowrap; }
.cc__history-row { display: flex; gap: 8rpx; padding: 0 24rpx; }
.cc__history-chip {
  display: inline-block; font-size: 22rpx; color: #5b5e63;
  background: #efe9df; border-radius: 999rpx; padding: 6rpx 20rpx;
}
.cc__results { flex: 1; padding: 8rpx 24rpx; }
.cc__hint { font-size: 26rpx; color: #8a8f98; padding: 48rpx 0; text-align: center; }
.cc__section { font-size: 22rpx; font-weight: 600; color: #8a8f98; padding: 24rpx 0 8rpx; }
.cc__empty { font-size: 26rpx; color: #8a8f98; padding: 8rpx 0; }
.cc__row {
  background: #fbf8f2; border-radius: 12rpx; padding: 16rpx 20rpx; margin-bottom: 8rpx;
}
.cc__row-title { display: block; font-size: 28rpx; color: #17181a; overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap; }
.cc__row-meta { display: block; font-size: 22rpx; color: #8a8f98; }
