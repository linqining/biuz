<!-- 010-任务主页：设备行 + 新建任务 + 任务列表头 + 分区列表 + 底部账号 -->
<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight + 12}}px">
    <view class="nav__device" bind:tap="onSwitchDevice">
      <text class="nav__device-icon">💻</text>
      <text class="nav__device-name">{{deviceName}}</text>
      <text class="nav__chevron">⌄</text>
    </view>
    <view class="nav__new" bind:tap="onNewTask">
      <text class="nav__new-icon">⊕</text>
      <text class="nav__new-label">新建任务</text>
    </view>
  </view>

  <view class="toolbar">
    <text class="toolbar__title">任务列表</text>
    <text class="toolbar__view">{{viewLabel}}</text>
    <view class="toolbar__action" bind:tap="onOpenViewMenu">≣</view>
  </view>

  <scroll-view class="list" scroll-y>
    <view wx:if="{{status === 'loading'}}" class="list__state">
      <loading-state text="正在同步任务…" />
    </view>

    <view wx:elif="{{status === 'disconnected' || status === 'idle'}}" class="list__state">
      <empty-state
        title="未连接桌面端"
        hint="连接后，桌面端的任务与会话会出现在这里" />
      <button class="list__connect-btn" bindtap="onConnectDesktop" data-test="00-act-connect">连接桌面端</button>
    </view>

    <block wx:elif="{{sections.length}}">
      <view class="section" wx:for="{{sections}}" wx:key="key">
        <!-- G36 grouped 分区组头：色点 + 点击循环换色 + 长按置顶（web TaskGroupedView 同构） -->
        <view wx:if="{{view === 'grouped' && item.key !== 'section:pinned' && item.key !== 'section:unread' && item.key !== 'ungrouped'}}"
          class="group-head" bind:tap="onGroupHeaderTap" bind:longpress="onGroupHeaderLongPress"
          data-title="{{item.title}}" data-testid="04-group-header">
          <view class="group-head__dot" wx:if="{{groupColors[item.title]}}"
            style="background: {{item.colorHex || groupColors[item.title]}};"></view>
          <view class="group-head__dot group-head__dot--gray" wx:else></view>
          <section-header
            title="{{item.title}}"
            count="{{item.count}}"
            collapsible="{{item.collapsible}}"
            collapsed="{{item.collapsed}}"
            sectionKey="{{item.key}}"
            bind:toggle="onToggleSection" />
        </view>
        <section-header
          wx:else
          title="{{item.title}}"
          count="{{item.count}}"
          collapsible="{{item.collapsible}}"
          collapsed="{{item.collapsed}}"
          sectionKey="{{item.key}}"
          bind:toggle="onToggleSection" />
        <block wx:if="{{!item.collapsed}}">
          <session-row
            wx:for="{{item.items}}"
            wx:for-item="row"
            wx:key="id"
            row="{{row}}"
            bind:open="onOpenRow"
            bind:menu="onRowMenu"
            bind:snooze="onRowSnooze" />
          <!-- G34 置顶溢出「显示更多/收起」（web taskList.showMore/showLess 同语义） -->
          <view class="pinned-more" wx:if="{{item.key === 'section:pinned' && pinnedOverflow > 0}}"
            bind:tap="onTogglePinnedMore" data-testid="04-act-pinned-more">
            <text>{{showAllPinned ? '收起置顶' : '显示更多置顶（' + pinnedOverflow + '）'}}</text>
          </view>
        </block>
      </view>
    </block>

    <view wx:else class="list__state">
      <empty-state title="还没有任务" hint="点「新建任务」在桌面端开一个会话" />
    </view>

    <view class="list__error" wx:if="{{error}}">
      <error-line message="{{error}}" retryable bind:retry="onRetry" />
    </view>
  </scroll-view>

  <!-- 008-版本提示：阻断式（web webRemoteControlVersionNotice 同文案），只能重新加载 -->
  <view class="version-mask" wx:if="{{versionNotice}}">
    <view class="version-card">
      <text class="version-title">桌面版本已更新</text>
      <text class="version-body">桌面当前版本为 {{versionNotice}}。任务操作已暂停，请重新加载以继续。未发送的附件不会保留。</text>
      <view class="version-action" bind:tap="onVersionReload">重新加载</view>
    </view>
  </view>

  <view class="footer safe-bottom">
    <view class="footer__account" bind:tap="onAccount">
      <view class="footer__avatar">{{accountInitial || '·'}}</view>
      <text class="footer__name">{{accountName || '未登录'}}</text>
    </view>
    <!-- G38 统一搜索入口（web ⌘K CommandCenter 移动对位） -->
    <view class="footer__settings" bind:tap="onOpenCommandCenter" data-testid="04-act-command-center">🔍</view>
    <view class="footer__settings" bind:tap="onSettings">⚙</view>
  </view>
</view>
