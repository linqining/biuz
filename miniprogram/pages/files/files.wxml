<!-- 030-文件管理器：文件树（只读）；点文件出预览层（内容未接入时如实提示） -->
<view class="page files-page" style="padding-top: {{statusBarHeight}}px">
  <view class="files-header">
    <text class="files-header__back" bind:tap="onBack">‹</text>
    <text class="files-header__title">工作区文件</text>
    <text class="files-header__spacer"></text>
  </view>

  <view class="files-workspace" wx:if="{{workspacePath}}">
    <text class="files-workspace__label">工作区</text>
    <text class="files-workspace__path">{{workspacePath}}</text>
  </view>

  <scroll-view class="files-list" scroll-y>
    <view wx:if="{{status === 'loading' && rows.length === 0}}" class="files-state">
      <loading-state text="正在读取文件树…" />
    </view>

    <view wx:elif="{{status === 'disconnected'}}" class="files-state">
      <empty-state title="未连接桌面端" hint="文件树为只读视图，连接后按会话归属工作区读取" />
    </view>

    <view wx:elif="{{rows.length === 0}}" class="files-state">
      <empty-state title="工作区暂无文件" hint="连接桌面端后读取会话归属工作区" />
    </view>

    <block wx:else>
      <view
        class="tree-row"
        wx:for="{{rows}}"
        wx:key="node.id"
        data-path="{{item.node.path}}"
        data-expandable="{{item.expandable}}"
        bind:tap="onRowTap"
        style="padding-left: {{32 + item.depth * 32}}rpx">
        <text class="tree-row__icon">{{item.node.isDirectory ? (item.expanded ? '📂' : '📁') : '📄'}}</text>
        <text class="tree-row__name">{{item.node.name}}</text>
        <text class="tree-row__size">{{item.sizeText}}</text>
        <text class="tree-row__chevron" wx:if="{{item.node.isDirectory}}">{{item.expanded ? '⌄' : '›'}}</text>
      </view>
    </block>

    <error-line wx:if="{{error}}" message="{{error}}" retryable bind:retry="onBack" />
    <view class="files-list__pad"></view>
  </scroll-view>

  <!-- 预览层（底部 sheet；内容未接入连接层时如实提示） -->
  <view class="preview-mask" wx:if="{{preview}}" bind:tap="onClosePreview"></view>
  <view class="preview" wx:if="{{preview}}">
    <view class="preview__grab"></view>
    <view class="preview__head">
      <text class="preview__name">{{preview.name}}</text>
      <text class="preview__close" bind:tap="onClosePreview">✕</text>
    </view>
    <text class="preview__path">{{preview.path}}</text>
    <!-- G42 残面：三键行内控制（字号循环/行号/换行；web codePreviewSettings 同语义） -->
    <view class="preview__controls" wx:if="{{previewContent}}">
      <text class="preview__ctl" bind:tap="onPreviewFontSize"
        data-testid="42-font-size">{{previewSettings.fontSizePx}}px</text>
      <text class="preview__ctl {{previewSettings.showLineNumbers ? 'preview__ctl--on' : ''}}"
        bind:tap="onPreviewToggleLineNumbers" data-testid="42-line-numbers">行号</text>
      <text class="preview__ctl {{previewSettings.wrapLongLines ? 'preview__ctl--on' : ''}}"
        bind:tap="onPreviewToggleWrap" data-testid="42-wrap">换行</text>
    </view>
    <view class="preview__loading" wx:if="{{preview.loading}}">
      <text class="preview__hint">读取中…</text>
    </view>
    <view class="preview__body" wx:elif="{{previewContent}}">
      <block wx:if="{{previewSettings.showLineNumbers}}">
        <view class="preview__line" wx:for="{{previewLines}}" wx:key="index">
          <text class="preview__ln">{{index + 1}}</text>
          <text class="preview__line-text"
            style="font-size: {{previewSettings.fontSizePx * 2}}rpx; {{previewSettings.wrapLongLines ? '' : 'white-space: nowrap;'}}">{{item || ' '}}</text>
        </view>
        <view class="preview__truncated" wx:if="{{preview.truncated}}">
          内容过长，仅显示前 256KB
        </view>
      </block>
      <text wx:else class="preview__text"
        style="font-size: {{previewSettings.fontSizePx * 2}}rpx; {{previewSettings.wrapLongLines ? '' : 'white-space: nowrap;'}}">{{previewContent}}</text>
    </view>
    <view class="preview__empty" wx:else>
      <text class="preview__hint">{{preview.loading ? '读取中…' : '预览需要连接桌面端（文件只读，写操作由桌面端执行）'}}</text>
    </view>
    <view class="preview__safe"></view>
  </view>
</view>
