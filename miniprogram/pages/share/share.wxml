<!-- 009-分享落地：只读预览（loading / ready / error 三态） -->
<view class="page share-page" style="padding-top: {{statusBarHeight}}px">
  <view class="share-header">
    <text class="share-header__title">会话分享</text>
    <text class="share-header__close" bind:tap="onClose">✕</text>
  </view>

  <scroll-view class="share-body" scroll-y>
    <view wx:if="{{status === 'loading'}}" class="share-state">
      <loading-state text="正在获取分享内容…" />
    </view>

    <view wx:elif="{{status === 'error'}}" class="share-state">
      <text class="share-error__icon">🔗</text>
      <text class="share-error__text">{{errorText}}</text>
      <view class="share-error__action" bind:tap="onRetry">重试</view>
    </view>

    <block wx:else>
      <view class="share-meta">
        <text class="share-meta__title">{{preview.title || '未命名会话'}}</text>
        <text class="share-meta__owner" wx:if="{{preview.ownerName}}">{{preview.ownerName}}</text>
      </view>

      <view class="share-row" wx:for="{{preview.rows}}" wx:key="index">
        <text class="share-row__role">{{item.isUser ? '你' : 'Agent'}}</text>
        <text class="share-row__text" user-select>{{item.text}}</text>
      </view>

      <text class="share-unsupported" wx:if="{{preview.unsupportedRowCount > 0}}">
        另有 {{preview.unsupportedRowCount}} 行内容暂不支持预览
      </text>
    </block>

    <view class="share-body__pad"></view>
  </scroll-view>
</view>
