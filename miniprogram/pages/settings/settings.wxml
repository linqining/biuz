<!-- 013-设置：基础设置 / 数据与统计 / 关于（品牌行连点 7 次出开发者组） -->
<view class="page settings-page" style="padding-top: {{statusBarHeight}}px">
  <view class="settings-header">
    <text class="settings-header__back" bind:tap="onBack" data-test="13-act-back">‹</text>
    <text class="settings-header__title">设置</text>
  </view>

  <scroll-view class="settings-body" scroll-y>
    <view class="group">
      <text class="group__title">基础设置</text>
      <view class="row" bind:tap="onChooseLanguage">
        <text class="row__label">语言</text>
        <text class="row__value">{{languageLabel}}</text>
        <text class="row__chevron">›</text>
      </view>
      <view class="row" bind:tap="onChooseAppearance">
        <text class="row__label">外观</text>
        <text class="row__value">{{appearanceLabel}}</text>
        <text class="row__chevron">›</text>
      </view>
    </view>

    <view class="group">
      <text class="group__title">数据与统计</text>
      <view class="row" bind:tap="onOpenUsage">
        <text class="row__label">用量统计</text>
        <text class="row__value">需要连接桌面端</text>
        <text class="row__chevron">›</text>
      </view>
    </view>

    <view class="group">
      <text class="group__title">Agent 能力</text>
      <view class="row" bind:tap="onOpenCapability" data-kind="memory" data-test="12-row-memory">
        <text class="row__label">记忆</text>
        <text class="row__value">桌面端项目记忆（只读）</text>
        <text class="row__chevron">›</text>
      </view>
      <view class="row" bind:tap="onOpenCapability" data-kind="skills" data-test="12-row-skills">
        <text class="row__label">技能</text>
        <text class="row__value">桌面端技能目录（只读）</text>
        <text class="row__chevron">›</text>
      </view>
      <view class="row" bind:tap="onOpenCapability" data-kind="mcp" data-test="12-row-mcp">
        <text class="row__label">MCP</text>
        <text class="row__value">MCP 服务器状态（只读）</text>
        <text class="row__chevron">›</text>
      </view>
      <view class="row" bind:tap="onOpenCapability" data-kind="plugins" data-test="12-row-plugins">
        <text class="row__label">插件</text>
        <text class="row__value">桌面端已装插件（只读）</text>
        <text class="row__chevron">›</text>
      </view>
    </view>

    <view class="group">
      <text class="group__title">关于</text>
      <view class="row" bind:tap="onOpenAbout">
        <text class="row__label">版本</text>
        <text class="row__value">{{version}}</text>
        <text class="row__chevron">›</text>
      </view>
    </view>

    <view class="group" wx:if="{{showDeveloper}}">
      <text class="group__title">开发者</text>
      <view class="row">
        <text class="row__label">远控地址</text>
        <text class="row__value">未连接</text>
      </view>
    </view>

    <view class="brand" bind:tap="onBrandTap">
      <text class="brand__name">朱批</text>
      <text class="brand__meta">ZCode 桌面端 · 移动遥控台</text>
    </view>
  </scroll-view>
</view>
