/* 011-会话对话 —— 尺寸换算 1px ≈ 1.923rpx（web 手机壳 390pt 视口）。
   颜色全部来自 app.wxss 的 web 对齐 token。 */

.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: var(--color-background);
}

/* 顶栏：web h-11（44px）+ border-b + px-2 */
.chat-header {
  flex: 0 0 auto;
  border-bottom: 2rpx solid var(--color-border);
  background-color: var(--color-background);
}
.chat-header__bar {
  height: 85rpx;
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: 0 16rpx;
}
.chat-header__back {
  width: 85rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--color-foreground);
}
.chat-header__title {
  flex: 1;
  min-width: 0;
  font-size: var(--font-base);
  font-weight: 500;
  color: var(--color-foreground);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.chat-header__theme {
  width: 62rpx;
  text-align: center;
  font-size: var(--font-base);
}

/* 项目行：web px-2 py-1.5 + 13px */
.chat-project {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: 12rpx 32rpx;
  border-bottom: 2rpx solid var(--color-border);
}
.chat-project__icon { font-size: var(--font-base); }
.chat-project__name {
  flex: 1;
  min-width: 0;
  font-size: var(--font-base);
  color: var(--color-foreground);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.chat-project__more { color: var(--color-muted-2); font-size: var(--font-lg); }

/* 消息流 */
.chat-list {
  flex: 1;
  min-height: 0;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}
.chat-list__pad { height: 48rpx; }
.chat-state { padding: 96rpx 0; }

.msg { display: flex; flex-direction: column; gap: 8rpx; margin-bottom: var(--space-4); }
.msg--user { align-items: flex-end; }

/* 用户气泡：web --color-user-message-bubble = 白 8% */
.msg__bubble {
  max-width: 88%;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  background-color: rgba(255, 255, 255, 0.08);
}
.msg__text {
  font-size: var(--font-base);
  line-height: 44rpx;
  color: var(--color-foreground);
  word-break: break-word;
}

/* 助手正文 */
.msg__assistant { display: flex; flex-direction: column; gap: 12rpx; }
.md-text {
  font-size: var(--font-base);
  line-height: 46rpx;
  color: var(--color-foreground);
  word-break: break-word;
}
.md-heading {
  font-size: var(--font-lg);
  font-weight: 600;
  line-height: 48rpx;
  color: var(--color-foreground);
  margin-top: 8rpx;
}
.md-heading--1 { font-size: 38rpx; }
.md-heading--2 { font-size: var(--font-lg); }
.md-code {
  padding: 20rpx;
  border-radius: var(--radius-sm);
  background-color: var(--color-card);
  border: 2rpx solid var(--color-border);
}
.md-code__text {
  font-family: Menlo, Consolas, monospace;
  font-size: var(--font-sm);
  line-height: 38rpx;
  color: var(--color-foreground);
  white-space: pre-wrap;
  word-break: break-all;
}

/* 工具卡 / 思考块 */
.msg__tool {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: 16rpx 20rpx;
  border-radius: var(--radius-sm);
  background-color: var(--color-card);
  border: 2rpx solid var(--color-border);
}
.msg__tool-name { flex: 1; font-size: var(--font-sm); color: var(--color-foreground); }
.msg__tool-status { font-size: var(--font-xs); color: var(--color-muted); }
.msg__thinking {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 16rpx 20rpx;
  border-left: 4rpx solid var(--color-border-strong);
}
.msg__thinking-label { font-size: var(--font-xs); color: var(--color-muted-2); }
.msg__thinking-text { font-size: var(--font-sm); line-height: 40rpx; color: var(--color-muted); }

/* 动作行（复制 + 时间，对齐 web 消息底部动作行） */
.msg__actions {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding-top: 4rpx;
}
.msg__action { font-size: var(--font-xs); color: var(--color-muted); }
.msg__time { font-size: var(--font-xs); color: var(--color-muted-2); }

/* composer：web 圆角输入区 + 工具行 */
.composer {
  flex: 0 0 auto;
  padding: 8rpx 24rpx 24rpx;
  background-color: var(--color-background);
}
.composer__box {
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  background-color: var(--color-card);
  padding: 16rpx 20rpx;
}
.composer__input {
  width: 100%;
  min-height: 60rpx;
  font-size: var(--font-base);
  line-height: 44rpx;
  color: var(--color-foreground);
}
.composer__ph { color: var(--color-muted-2); }
.composer__tools {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding-top: 8rpx;
}
.composer__tool { font-size: var(--font-lg); color: var(--color-muted); }
.composer__spacer { flex: 1; }
.composer__send {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: var(--color-accent);
  color: var(--color-on-accent);
  font-size: var(--font-lg);
  text-align: center;
  line-height: 60rpx;
}

/* Markdown 行内标记 / 列表 / 表格 / 代码块语言标签（与 iOS TinyMarkdown、Android MarkdownText 同口径） */
.md-bold { font-weight: 600; }
.md-italic { font-style: italic; }
.md-inline-code {
  font-family: Menlo, Consolas, monospace;
  font-size: var(--font-xs);
  padding: 0 6rpx;
  border-radius: 4rpx;
  background-color: rgba(127, 127, 127, 0.16);
}

.md-list { display: flex; align-items: flex-start; gap: 12rpx; margin: 4rpx 0; }
.md-list__dot { font-size: var(--font-sm); color: var(--color-muted-2); line-height: 44rpx; }
.md-list__text { flex: 1; min-width: 0; }

.md-code__lang { display: block; font-size: 18rpx; color: var(--color-muted-2); padding: 4rpx 0 2rpx; font-family: Menlo, Consolas, monospace; }

.md-table { border: 2rpx solid var(--color-border); border-radius: var(--radius-md); background-color: var(--color-card); white-space: nowrap; }
.md-table__head { display: flex; gap: 24rpx; padding: 10rpx 16rpx; background-color: rgba(127, 127, 127, 0.10); }
.md-table__row { display: flex; gap: 24rpx; padding: 10rpx 16rpx; border-top: 2rpx solid var(--color-border); }
.md-table__cell { font-family: Menlo, Consolas, monospace; font-size: var(--font-xs); color: var(--color-foreground); }
.md-table__cell--head { font-weight: 600; }

.msg__action--active { color: #2563eb; font-weight: bold; }

/* ---- 审批卡区（盖章子轮 2026-11-22；token 用 app.wxss 印系变量） ---- */
.cards {
  padding: 0 24rpx 12rpx;
}
.card {
  position: relative;
  background: var(--color-card);
  border: 1rpx solid var(--color-border-strong);
  border-radius: var(--radius-md);
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
}
.card__head { margin-bottom: 10rpx; }
.card__title {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-foreground);
}
.card__cmd {
  background: var(--color-code);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 10rpx 14rpx;
  margin-bottom: 14rpx;
}
.card__cmd-text {
  font-size: var(--font-xs);
  color: var(--color-muted);
  word-break: break-all;
}
.card__impact {
  font-size: var(--font-sm);
  color: var(--color-muted);
  margin-bottom: 12rpx;
}
.card__chips { display: flex; gap: 12rpx; margin-bottom: 16rpx; flex-wrap: wrap; }
.chip {
  font-size: var(--font-sm);
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--color-border-strong);
  color: var(--color-foreground);
  background: var(--color-card);
}
.chip--on { background: var(--color-accent); color: var(--color-on-accent); }

/* G22 多题向导：题面 + 进度（一次一题，iOS 向导段同构） */
.card__qtitle { display: block; font-size: 14px; color: var(--color-foreground); margin-bottom: 4px; }
.card__qcount { display: block; font-size: 11px; color: var(--color-muted); margin-bottom: 8px; }
.card__actions { display: flex; gap: 16rpx; }
.btn {
  font-size: var(--font-sm);
  padding: 14rpx 34rpx;
  border-radius: var(--radius-sm);
  background: var(--color-accent);
  color: var(--color-on-accent);
}
.btn--ghost { background: var(--color-card); color: var(--color-foreground); border: 1rpx solid var(--color-border-strong); }
.card__input {
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-background);
  padding: 14rpx 18rpx;
  font-size: var(--font-sm);
  color: var(--color-foreground);
  margin-bottom: 14rpx;
}
.card__plan {
  background: var(--color-code);
  border-radius: var(--radius-sm);
  padding: 14rpx 18rpx;
  margin-bottom: 14rpx;
}
.card__plan-text { font-size: var(--font-sm); color: var(--color-muted); white-space: pre-wrap; }
.card__error {
  margin-top: 14rpx;
  border: 1rpx solid rgba(210, 64, 46, 0.3);
  background: var(--color-seal-dim);
  border-radius: var(--radius-sm);
  padding: 10rpx 14rpx;
}
.card__error-text { font-size: var(--font-xs); color: var(--color-seal); word-break: break-all; }

/* ---- 朱批盖章（motion-spec：460ms 三段 + 外溢圈 520ms/180ms；落印恒 −2.5°） ---- */
.stamp {
  position: absolute;
  right: 16rpx;
  top: 50%;
  margin-top: -66rpx;
  width: 132rpx;
  height: 132rpx;
  pointer-events: none;
}
.stamp__face {
  width: 132rpx;
  height: 132rpx;
  /* 印面含右下残边（brand/seal 母版 polygon 近似：圆角直折，残边是签名不得修复） */
  clip-path: polygon(14% 0%, 86% 0%, 100% 14%, 100% 84%, 91% 86%, 94% 94%, 85% 96%, 82% 100%, 14% 100%, 0% 86%, 0% 14%);
  background: var(--color-seal);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  animation: stamp-in 460ms cubic-bezier(0.22, 0.68, 0.32, 1) both;
}
.stamp--mo .stamp__face { background: var(--color-foreground); }
.stamp__ch {
  font-size: 34rpx;
  font-weight: 900;
  color: var(--color-on-seal);
  font-family: "Songti SC", serif;
  line-height: 1.15;
}
.stamp--mo .stamp__ch { color: var(--color-background); }
.stamp__ring {
  position: absolute;
  left: 10%;
  top: 10%;
  width: 80%;
  height: 80%;
  border: 3rpx solid var(--color-seal);
  border-radius: 50%;
  animation: stamp-ring 520ms ease-out 180ms both;
}
.stamp--mo .stamp__ring { border-color: var(--color-foreground); }
@keyframes stamp-in {
  0% { transform: scale(1.6) rotate(-10deg); opacity: 0; }
  55% { transform: scale(0.96) rotate(-2deg); opacity: 1; }
  76% { transform: scale(1.04) rotate(-3.2deg); }
  100% { transform: scale(1) rotate(-2.5deg); opacity: 0.94; }
}
@keyframes stamp-ring {
  0% { transform: scale(0.9); opacity: 0.7; }
  100% { transform: scale(1.45); opacity: 0; }
}

/* G15 @ 提及候选浮层 */
.mention { position: fixed; inset: 0; z-index: 999; }
.mention__mask { position: absolute; inset: 0; background: rgba(0,0,0,0.4); }
.mention__panel {
  position: absolute; left: 0; right: 0; bottom: 0;
  max-height: 70vh; background: #fbf8f2;
  border-radius: 24rpx 24rpx 0 0; padding: 24rpx;
  display: flex; flex-direction: column;
}
.mention__head { display: flex; justify-content: space-between; align-items: center; }
.mention__title { font-size: 34rpx; font-weight: 700; color: #17181a; }
.mention__close { font-size: 30rpx; color: #8a8f98; padding: 8rpx; }
.mention__input {
  margin: 16rpx 0; padding: 12rpx 24rpx; font-size: 26rpx;
  background: #efe9df; border-radius: 16rpx;
}
.mention__list { max-height: 50vh; }
.mention__empty { font-size: 26rpx; color: #8a8f98; padding: 32rpx 0; text-align: center; }
.mention__row { padding: 16rpx 8rpx; border-bottom: 1rpx solid rgba(23,24,26,0.06); }
.mention__row-name { display: block; font-size: 28rpx; color: #17181a; }
.mention__row-path {
  display: block; font-size: 20rpx; color: #8a8f98;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* G15 scope tabs */
.mention__tabs { display: flex; gap: 16rpx; }
.mention__tab {
  font-size: 24rpx; font-weight: 600; color: #5b5e63;
  padding: 8rpx 24rpx; border-radius: 999rpx; background: #efe9df;
}
.mention__tab--on { color: #d2402e; background: rgba(210, 64, 46, 0.14); }

/* G25 工作流 run 卡 */
.runs { padding: 8rpx 24rpx 0; }
.run-card {
  background: #fbf8f2; border-radius: 12rpx; padding: 16rpx 20rpx;
  margin-bottom: 8rpx; border: 1rpx solid rgba(210, 64, 46, 0.3);
}
.run-card__head { display: flex; align-items: center; gap: 12rpx; }
.run-card__glyph { color: #d2402e; font-size: 26rpx; }
.run-card__name { font-size: 26rpx; font-weight: 600; color: #17181a; flex: 1;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.run-card__status { font-size: 20rpx; color: #8a8f98; }
.run-card__status--running { color: #339cff; }
.run-card__status--completed { color: #16a34a; }
.run-card__status--errored { color: #dc2626; }
.run-card__lineage { margin-top: 8rpx; }
.run-card__lineage-text { font-size: 20rpx; color: #8a8f98; margin-right: 16rpx; }
.run-card__terminal {
  margin-top: 8rpx; background: #efe9df; border-radius: 8rpx; padding: 12rpx;
}
.run-card__terminal-text { font-size: 24rpx; color: #5b5e63;
  display: -webkit-box; -webkit-line-clamp: 8; -webkit-box-orient: vertical; overflow: hidden; }
.run-card__stopreason { margin-top: 8rpx; }
.run-card__stopreason-text { font-size: 22rpx; color: #8a8f98; }
.run-card__actions { margin-top: 12rpx; display: flex; gap: 16rpx; align-items: center; }
.run-card__act { font-size: 24rpx; font-weight: 600; }
.run-card__act--save { color: #17181a; }
.run-card__act--rerun { color: #d2402e; }
.run-card__notice { font-size: 20rpx; color: #8a8f98; flex: 1;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* G25 收口：阶段链 */
.run-card__phases { margin-top: 8rpx; }
.run-card__phase { display: flex; gap: 12rpx; padding: 4rpx 0; }
.run-card__phase-glyph { font-size: 22rpx; color: #d2402e; }
.run-card__phase-name { font-size: 24rpx; color: #5b5e63; }
