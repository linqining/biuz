<?xml version="1.0" encoding="utf-8"?>
<!-- 框架 Material 深色 NoActionBar（零 appcompat 依赖，ComponentActivity 直挂）。
     真实配色由 Compose BiuZTheme 接管；这里只负责冷启窗底（bg 令牌 = 近黑 #0a0b0d，防白闪）。
     edge-to-edge 由 MainActivity.enableEdgeToEdge() 在运行时接管，不在此设状态栏色。 -->
<resources>
    <style name="Theme.BiuZ" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/biuz_bg</item>
    </style>
</resources>
